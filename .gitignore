# Godot 4+ specific ignores
.godot/
.lumo-voice-staging/
.import/

# Imported resources (Godot regeneriert beim Editor-Start)
*.import
# Explicit production LODs and embedded textures are part of the runtime contract.
!assets/kart/production/**/*.glb.import
# Dorfwelt: Mipmaps für Gelände-/Atlas-Texturen und Mesh-LODs der Modelle sind Teil des Laufzeitvertrags.
!assets/creative/village3d/**/*.import
!assets/creative/bauwelt_voxel/*.import
# Jungle models of Lumo Lauf: no automatic LODs (explicit _lod models), mipmapped textures.
!assets/games/run/jungle/models/*.glb.import
!assets/games/run/jungle/models/textures/*.import
# Die Bildliste ist keine Übersetzung. Als CSV-Übersetzung importiert löst sie
# im Importer TRANSLATION_CHANGED aus einem Arbeits-Thread aus (Absturz im CI).
!assets/characters/lumo/reference/lumo_reference_manifest.csv.import
# Lumo Schach: Holz-, Brett- und Symboltexturen mit Mipmaps (scharf unter flachem Blickwinkel).
!assets/chess/**/*.import

# Export-Output (lokale Builds nicht ins Repo)
exports/

# AI-generierte / Dryrun-Asset-Outputs (werden via tools/fetch_assets.py
# bei Bedarf regeneriert - Source-of-Truth ist tools/assets.json).
assets/models/*.glb
assets/models/*.gltf
assets/textures/*.png
assets/textures/*.jpg
assets/textures/*.exr
!assets/models/.gitkeep
!assets/textures/.gitkeep

# Translations-Cache (nicht im Repo)
*.translation

# Editor-User-Cache
.vscode/
.idea/

# WICHTIG: export_presets.cfg WIRD committed (Build-Config, nicht User-Cache).
# project.godot wird natuerlich auch committed.
android/build/

__pycache__/
*.pyc

# Generated developer-pack build output (GitHub Actions artifacts only)
dist/
