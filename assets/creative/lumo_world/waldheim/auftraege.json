            {
              "label": "Auftrag übernehmen",
              "action": "complete"
            },
            {
              "label": "Später wiederkommen",
              "action": "close"
            }
          ]
        }
      }
    },
    "spurwechsel_end": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Du hast den Wildwechsel freigelassen. Wir können Tiere auch vom Weg aus beobachten.",
