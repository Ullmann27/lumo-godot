  "dialogs": {
    "wegzeichen_start": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Willkommen am Waldsteg! Wir machen den Waldweg heute bereit für Gäste.",
          "choices": [
            {
              "label": "Auftrag übernehmen",
              "action": "complete"
            },
            {
              "label": "Später wiederkommen",
              "action": "close"
            }
          ]
        }
      }
    },
    "wegzeichen_end": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Jetzt finden auch Gäste die Lichtung. Danke fürs genaue Hinsehen!",
          "choices": [
            {
              "label": "Auftrag abschließen",
              "action": "complete"
            }
          ]
        }
      }
    },
    "spurwechsel_start": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Ich habe Abdrücke am Wildwechsel gefunden. Wir suchen einen Weg, auf dem wir die Tiere in Ruhe lassen.",
