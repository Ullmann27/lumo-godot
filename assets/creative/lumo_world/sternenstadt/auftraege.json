  "dialogs": {
    "parkblick_start": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Mehrere Gäste möchten eine Pause machen. Schau am Holztisch im Freundschaftspark nach: Wie viele Bänke stehen direkt am Tisch?",
          "choices": [
            {
              "label": "Auftrag übernehmen",
              "action": "complete"
            },
            {
              "label": "Später",
              "action": "close"
            }
          ]
        }
      }
    },
    "parkblick_end": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Zwei Bänke stehen am Tisch. Jetzt weiß ich, wo ich die Gäste hinbitten kann.",
          "choices": [
            {
              "label": "Auftrag abschließen",
              "action": "complete"
            },
            {
              "label": "Später",
              "action": "close"
            }
          ]
        }
      }
    },
    "stadtroute_start": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Unser Stadtplan soll Familien helfen, den Park zu finden. Geh nacheinander zum Klinik-Vorplatz, durch die Marktpassage und zum Parkeingang. Folge den Markierungen und erzähle mir danach vom Weg.",
          "choices": [
            {
              "label": "Auftrag übernehmen",
              "action": "complete"
            },
            {
              "label": "Später",
              "action": "close"
            }
          ]
        }
      }
    },
    "stadtroute_end": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Die drei Orte sind jetzt richtig auf der Karte verbunden. Andere Familien können denselben Weg finden.",
          "choices": [
            {
              "label": "Auftrag abschließen",
              "action": "complete"
            },
            {
              "label": "Später",
              "action": "close"
            }
          ]
        }
      }
    },
    "marktlicht_start": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Ruth braucht eine kleine Laterne für den Parkeingang. Du bekommst sechs Auftragsmarken. Wähle am Marktstand den passenden Artikel und behalte das Rückgeld.",
          "choices": [
            {
              "label": "Auftrag übernehmen",
              "action": "complete"
            },
            {
              "label": "Später",
              "action": "close"
            }
          ]
        }
      }
    },
    "marktlicht_end": {
      "start": "entry",
      "nodes": {
        "entry": {
          "text": "Die Laterne kostet vier Marken. Zwei Marken sind übrig. Ich bringe die Laterne zu Ruth.",
          "choices": [
            {
              "label": "Auftrag abschließen",
              "action": "complete"
            },
            {
              "label": "Später",
              "action": "close"
            }
          ]
        }
      }
    }
  },
