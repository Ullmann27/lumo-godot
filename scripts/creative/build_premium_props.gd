static func build(kit, body: StaticBody3D, item: Dictionary) -> void:
	var id: String = str(item.shape)
	if not RECIPES.has(id):
		push_error("Unknown premium Bauwelt asset: " + id)
		return
	for spec in RECIPES[id]:
		var p: Array = spec[1]
		var s: Array = spec[2]
		var at := Vector3(float(p[0]), float(p[1]), float(p[2]))
		var size := Vector3(float(s[0]), float(s[1]), float(s[2]))
		var tint := Color(str(spec[3]))
		var piece: MeshInstance3D
		match str(spec[0]):
			"box":
				piece = kit.box(body, at, size, tint)
			"prism":
				var roof := PrismMesh.new()
				roof.size = size
				piece = kit.mesh(body, roof, at, tint)
			"sphere":
				piece = kit.sphere(body, at, size, tint)
			"cylinder":
				piece = kit.cylinder(body, at, size.x, size.y, tint, size.z)
			_:
				push_error("Unsupported primitive: " + str(spec[0]))
				continue
		if spec.size() > 4:
			var angles: Array = spec[4]
			piece.rotation_degrees = Vector3(float(angles[0]), float(angles[1]), float(angles[2]))
	# Exact cell-space persistence/turn/overlap is handled by build_state.gd.
	# A matching rigid body keeps the decoration collidable in the actual world.
	var footprint: Vector3 = item.size
	kit.collision(body, footprint * 0.5, footprint * 0.96)
