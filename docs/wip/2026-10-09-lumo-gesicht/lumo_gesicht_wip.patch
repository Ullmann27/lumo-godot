@@ -81,3 +92,54 @@ static func iris(size: Vector3) -> ArrayMesh:
 	var result := ArrayMesh.new()
 	result.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
 	return result
+
+
+## Iris und Pupille als eine Kappe, die genau auf dem Augapfel (Ellipsoid `eye_radius`) liegt,
+## statt als flache Scheibe davor: von der Seite steht nichts heraus. `center` ist der Versatz
+## der Iris auf dem Auge (x, y), Farben von innen nach außen: Pupille, warme Iris, dunkler Ring.
+static func iris_cap(
+	eye_radius: Vector3, center: Vector2, iris_radius: float, pupil_radius: float,
+	inner: Color = Color("c47a30"), outer: Color = Color("7a3a14")
+) -> ArrayMesh:
+	const SECTIONS: int = 48
+	const RINGS: int = 9
+	var vertices := PackedVector3Array()
+	var normals := PackedVector3Array()
+	var colors := PackedColorArray()
+	var indices := PackedInt32Array()
+	for row in range(RINGS + 1):
+		var radius: float = float(row) / RINGS
+		for segment in range(SECTIONS + 1):
+			var angle: float = TAU * float(segment) / SECTIONS
+			var x: float = center.x + cos(angle) * radius * iris_radius
+			var y: float = center.y + sin(angle) * radius * iris_radius * 1.04
+			var inside: float = 1.0 - pow(x / eye_radius.x, 2.0) - pow(y / eye_radius.y, 2.0)
+			var z: float = -eye_radius.z * sqrt(maxf(0.0, inside)) - 0.0018
+			vertices.append(Vector3(x, y, z))
+			normals.append(
+				Vector3(x / pow(eye_radius.x, 2.0), y / pow(eye_radius.y, 2.0), z / pow(eye_radius.z, 2.0)).normalized()
+			)
+			var distance: float = radius * iris_radius
+			var fibre: float = sin(angle * 27.0 + radius * 8.0) * 0.5 + sin(angle * 41.0 - radius * 5.0) * 0.25
+			# Unten heller (Licht fällt in die Iris), oben dunkler unter dem Lid.
+			var warm: Color = outer.lerp(inner, clampf(0.55 + fibre * 0.22 - sin(angle) * 0.25, 0.0, 1.0))
+			var color: Color = warm.lerp(Color("2a140a"), smoothstep(0.80, 1.0, radius))
+			if distance <= pupil_radius:
+				color = Color("07090d")
+			elif distance <= pupil_radius * 1.18:
+				color = Color("07090d").lerp(warm, (distance - pupil_radius) / (pupil_radius * 0.18))
+			colors.append(color)
+	for row in range(RINGS):
+		for segment in range(SECTIONS):
+			var a: int = row * (SECTIONS + 1) + segment
+			var b: int = a + SECTIONS + 1
+			indices.append_array(PackedInt32Array([a, b, b + 1, a, b + 1, a + 1]))
+	var arrays: Array = []
+	arrays.resize(Mesh.ARRAY_MAX)
+	arrays[Mesh.ARRAY_VERTEX] = vertices
+	arrays[Mesh.ARRAY_NORMAL] = normals
+	arrays[Mesh.ARRAY_COLOR] = colors
+	arrays[Mesh.ARRAY_INDEX] = indices
+	var result := ArrayMesh.new()
+	result.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	return result
