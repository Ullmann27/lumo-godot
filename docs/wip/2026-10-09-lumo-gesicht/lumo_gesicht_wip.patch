+extends SceneTree
+## Lumo-Prüfansichten aus der echten Engine: die acht Ansichten des Auftrags und eine Messung der
+## Gesichtsproportionen am gerenderten Rig (keine Bildbearbeitung, kein Übermalen).
+## Aufruf:
+## godot --rendering-method gl_compatibility --script res://scripts/tests/kart_lumo_views_capture.gd -- <ordner>
+## Ergebnis: 01-gesicht-front.png … 08-verfolger-fahrt.png und face-metrics.json.
+## Gemessen wird in der Frontansicht: Kopfbreite = Silhouette (Alphakanal) in der Augenzeile,
+## Augen, Iris, Pupille, Nase aus den projizierten Punkten des Rigs (Metadaten des Kopfes).
+
+const CATALOG = preload("res://scripts/games/kart_catalog.gd")
+const STAGE = preload("res://scripts/games/kart_stage.gd")
+const CELL := Vector2i(960, 960)
+const STEP: float = 1.0 / 60.0
+
+var out_dir: String = "res://exports/lumo-views"
+var viewport: SubViewport
+var camera: Camera3D
+var kart: Node3D
+var companion: Node3D
+var metrics: Dictionary = {}
+
+
+func _initialize() -> void:
+	var args := OS.get_cmdline_user_args()
+	if args.size() > 0:
+		out_dir = args[0]
+	call_deferred("_run")
+
+
+func _frames(count: int) -> void:
+	for frame in range(count):
+		await process_frame
+	await RenderingServer.frame_post_draw
+
+
+func _stage() -> void:
+	viewport = SubViewport.new()
+	viewport.size = CELL
+	viewport.own_world_3d = true
+	viewport.msaa_3d = Viewport.MSAA_4X
+	viewport.transparent_bg = true
+	viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
+	root.add_child(viewport)
+	var world := Node3D.new()
+	viewport.add_child(world)
+	var built: Dictionary = STAGE.build(world, Color("45d9ef"), false)
+	(built.camera as Camera3D).queue_free()
+	camera = Camera3D.new()
+	world.add_child(camera)
+	camera.current = true
+	kart = Node3D.new()
+	kart.set_script(load("res://scripts/games/kart_vehicle.gd"))
+	world.add_child(kart)
+	var driver: Dictionary = CATALOG.entry(CATALOG.DRIVERS, "fox")
+	kart.call("configure", "fox", driver.color, "comet")
+	kart.call("set_motion", 0.0, 0.0, false, false)
+	companion = Node3D.new()
+	companion.set_script(load("res://scripts/games/kart_vehicle.gd"))
+	world.add_child(companion)
+	companion.call("configure_companion", "fox")
+	companion.position = Vector3(40, 0, 0)
+	# Ruhige, offene Augen in allen Standbildern: Animation anhalten, Begleiter in Ruhepose.
+	kart.set_process(false)
+	companion.set_process(false)
+	companion.call("set_companion_pose", 0.5, "idle", 0.0)
+
+
+## Bild mit Verlauf hinterlegen; der Alphakanal bleibt für die Silhouettenmessung erhalten.
+func _shot(file: String) -> Image:
+	await _frames(12)
+	var shot: Image = viewport.get_texture().get_image()
+	shot.convert(Image.FORMAT_RGBA8)
+	var backdrop := Image.create(CELL.x, CELL.y, false, Image.FORMAT_RGBA8)
+	for row in range(CELL.y):
+		backdrop.fill_rect(Rect2i(0, row, CELL.x, 1), Color("2f4a74").lerp(Color("14243f"), float(row) / CELL.y))
+	backdrop.blend_rect(shot, Rect2i(Vector2i.ZERO, shot.get_size()), Vector2i.ZERO)
+	assert(backdrop.save_png(out_dir.path_join(file)) == OK)
+	print("[LumoViews] ", file)
+	return shot
+
+
+func _look(from: Vector3, at: Vector3, fov: float) -> void:
+	camera.fov = fov
+	camera.look_at_from_position(from, at, Vector3.UP)
+
+
+func _screen(point: Vector3) -> Vector2:
+	return camera.unproject_position(point)
+
+
+## Breite der Silhouette in einer Bildzeile um eine Mittelspalte (nur zusammenhängende Pixel).
+func _silhouette(shot: Image, row: int, center: int) -> Vector2i:
+	var left: int = center
+	while left > 0 and shot.get_pixel(left - 1, row).a > 0.5:
+		left -= 1
+	var right: int = center
+	while right < shot.get_width() - 1 and shot.get_pixel(right + 1, row).a > 0.5:
+		right += 1
+	return Vector2i(left, right)
+
+
+func _face_metrics(shot: Image, rig: Node3D) -> Dictionary:
+	var head: Node3D = rig.get("head")
+	var face: Dictionary = head.get_meta("face_metrics", {})
+	assert(not face.is_empty(), "Kopf liefert Messpunkte")
+	var to_world: Transform3D = head.global_transform
+	var result: Dictionary = {}
+	var eyes: Array = []
+	for side in [-1.0, 1.0]:
+		var key: String = "left" if side < 0 else "right"
+		var center: Vector3 = face["eye_center_" + key]
+		var radius: Vector2 = face.eye_radius
+		var basis: Basis = face["eye_basis_" + key]
+		var c: Vector2 = _screen(to_world * center)
+		var x0: Vector2 = _screen(to_world * (center - basis.x * radius.x))
+		var x1: Vector2 = _screen(to_world * (center + basis.x * radius.x))
+		var y0: Vector2 = _screen(to_world * (center - basis.y * radius.y))
+		var y1: Vector2 = _screen(to_world * (center + basis.y * radius.y))
+		var iris_center: Vector3 = face["iris_center_" + key]
+		var i0: Vector2 = _screen(to_world * (iris_center - basis.x * float(face.iris_radius)))
+		var i1: Vector2 = _screen(to_world * (iris_center + basis.x * float(face.iris_radius)))
+		var p0: Vector2 = _screen(to_world * (iris_center - basis.x * float(face.pupil_radius)))
+		var p1: Vector2 = _screen(to_world * (iris_center + basis.x * float(face.pupil_radius)))
+		eyes.append({"center": c, "width": x0.distance_to(x1), "height": y0.distance_to(y1),
+			"iris": i0.distance_to(i1), "pupil": p0.distance_to(p1), "iris_center": _screen(to_world * iris_center)})
+	var row: int = roundi((eyes[0].center.y + eyes[1].center.y) * 0.5)
+	var middle: int = roundi((eyes[0].center.x + eyes[1].center.x) * 0.5)
+	var span: Vector2i = _silhouette(shot, row, middle)
+	var head_width: float = float(span.y - span.x)
+	var nose_l: Vector2 = _screen(to_world * (face.nose_center - Vector3(float(face.nose_half_width), 0, 0)))
+	var nose_r: Vector2 = _screen(to_world * (face.nose_center + Vector3(float(face.nose_half_width), 0, 0)))
+	var eye_width: float = (eyes[0].width + eyes[1].width) * 0.5
+	result = {
+		"head_width_px": head_width,
+		"eye_width_px": eye_width,
+		"eye_height_px": (eyes[0].height + eyes[1].height) * 0.5,
+		"eye_spacing_px": eyes[0].center.distance_to(eyes[1].center),
+		"inner_gap_px": eyes[0].center.distance_to(eyes[1].center) - (eyes[0].width + eyes[1].width) * 0.5,
+		"iris_px": (eyes[0].iris + eyes[1].iris) * 0.5,
+		"pupil_px": (eyes[0].pupil + eyes[1].pupil) * 0.5,
+		"nose_width_px": nose_l.distance_to(nose_r),
+	}
+	result["eye_to_head"] = eye_width / head_width
+	result["spacing_to_head"] = float(result.eye_spacing_px) / head_width
+	result["gap_to_head"] = float(result.inner_gap_px) / head_width
+	result["iris_to_eye"] = float(result.iris_px) / eye_width
+	result["pupil_to_iris"] = float(result.pupil_px) / float(result.iris_px)
+	result["eye_aspect"] = float(result.eye_height_px) / eye_width
+	result["nose_to_head"] = float(result.nose_width_px) / head_width
+	var inward: float = 0.0
+	var down: float = 0.0
+	for eye in eyes:
+		var towards_nose: float = signf(float(middle) - eye.center.x)
+		inward += (eye.iris_center.x - eye.center.x) * towards_nose
+		down += eye.iris_center.y - eye.center.y
+	result["iris_inward_to_eye"] = inward * 0.5 / eye_width
+	result["iris_down_to_eye"] = down * 0.5 / eye_width
+	return result
+
+
+func _race_shot(file: String) -> void:
+	root.size = Vector2i(1280, 720)
+	var game = load("res://scenes/games/kart_island.tscn").instantiate()
+	root.add_child(game)
+	game.set_physics_process(false)
+	await _frames(4)
+	game._start_selected_race({"mode": "training", "driver": "fox", "kart": "comet", "track": "sonnenhafen", "difficulty": "flott"})
+	game._end_preview()
+	await _frames(3)
+	game.countdown = 0
+	game.racing = true
+	game.auto_gas = true
+	for frame in range(150):
+		var target: Vector3 = game.world.position_at(game.previous_road_distance + 8.0, 0.0)
+		var direction: Vector3 = target - game.player.position
+		game.steering = clampf(-angle_difference(game.player_heading, atan2(-direction.x, -direction.z)) * 2.3, -1, 1)
+		game._physics_process(STEP)
+		if frame % 10 == 0:
+			await process_frame
+	await _frames(3)
+	var image: Image = root.get_texture().get_image()
+	assert(image.save_png(out_dir.path_join(file)) == OK)
+	print("[LumoViews] ", file)
+	game.abandoned = true
+	game.queue_free()
+	await _frames(6)
+
+
+func _run() -> void:
+	DirAccess.make_dir_recursive_absolute(out_dir)
+	_stage()
+	await _frames(4)
+	var head: Node3D = kart.get("head")
+	var face: Vector3 = head.global_position
+	var forward: Vector3 = -head.global_transform.basis.z
+	# 1–3: Gesicht frontal, seitlich (links), Kopf Dreiviertel.
+	# Lange Brennweite (fast orthografisch) wie bei den Referenzblättern, damit die Messung
+	# nicht von der Perspektive verzerrt wird.
+	var aim: Vector3 = face + Vector3(0, 0.08, 0)
+	_look(aim + forward * 6.0, aim, 11.5)
+	var front: Image = await _shot("01-gesicht-front.png")
+	metrics["face_front"] = _face_metrics(front, kart)
+	_look(aim + Vector3(-6.0, 0, 0), aim, 11.5)
+	await _shot("02-gesicht-seite.png")
+	_look(aim + forward * 4.4 + Vector3(-4.0, 0.6, 0), aim, 11.5)
+	await _shot("03-kopf-dreiviertel.png")
+	# 4: ganze Figur im Anzug (Begleiter-Rig, stehend).
+	var body_top: Vector3 = companion.global_position + Vector3(0, 1.05, 0)
+	_look(body_top + Vector3(0, 0.15, -4.9), body_top, 30.0)
+	await _shot("04-ganzkoerper.png")
+	# 5–7: im Kart frontal, Kart mit Fahrer seitlich und von hinten.
+	_look(Vector3(0, 1.45, -4.4), Vector3(0, 0.95, 0), 30.0)
+	await _shot("05-im-kart-front.png")
+	_look(Vector3(-5.2, 1.0, 0.05), Vector3(0, 0.75, 0.05), 30.0)
+	await _shot("06-kart-seite.png")
+	_look(Vector3(0, 1.45, 5.0), Vector3(0, 0.8, 0), 30.0)
+	await _shot("07-kart-heck.png")
+	kart.queue_free()
+	companion.queue_free()
+	viewport.queue_free()
+	await _frames(4)
+	# 8: Verfolgerkamera während einer echten Fahrt (Sonnenhafen, Fahrphysik).
+	await _race_shot("08-verfolger-fahrt.png")
+	var file := FileAccess.open(out_dir.path_join("face-metrics.json"), FileAccess.WRITE)
+	file.store_string(JSON.stringify(metrics, "  "))
+	file.close()
+	print("[LumoViews] metrics ", JSON.stringify(metrics))
+	await create_timer(1.3).timeout
+	print("[LumoViews] PASS: ", out_dir)
+	quit(0)
