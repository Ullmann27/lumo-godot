+## Abtastung eines Lofts an der Längsposition `at`, genau wie _loft die Ringe verbindet
+## (Catmull-Rom-Stützstellen, dazwischen gerade Flächen).
+func _profile_at(rings: Array[Vector4], at: float, steps: int = 5) -> Vector4:
+	var samples: Array[Vector4] = []
+	for index in range(rings.size() - 1):
+		for j in range(steps):
+			samples.append(_catmull(rings[maxi(0, index - 1)], rings[index], rings[index + 1], rings[mini(rings.size() - 1, index + 2)], float(j) / steps))
+	samples.append(rings[-1])
+	for index in range(samples.size() - 1):
+		var a: Vector4 = samples[index]
+		var b: Vector4 = samples[index + 1]
+		if (at - a.x) * (at - b.x) <= 0.0 and not is_equal_approx(a.x, b.x):
+			return a.lerp(b, (at - a.x) / (b.x - a.x))
+	return samples[0] if absf(at - samples[0].x) < absf(at - samples[-1].x) else samples[-1]
+
+
+## Vorderste Oberfläche (kleinstes z) eines senkrechten Lofts (Kopf) bei (x, y).
+func _head_front_z(rings: Array[Vector4], x: float, y: float) -> float:
+	var ring: Vector4 = _profile_at(rings, y)
+	var t: float = clampf(x / maxf(0.002, ring.y), -1.0, 1.0)
+	return ring.w - ring.z * sqrt(1.0 - t * t)
+
+
+## Fläche, die genau auf einem senkrechten Loft liegt (Anzugteile, Streifen, Leuchtlinien):
+## Winkelbereich wie in _loft (−π/2 = vorn), Höhenbereich in Ringkoordinaten, kleiner Abstand nach außen.
+func _loft_patch(rings: Array[Vector4], angle_a: float, angle_b: float, at_a: float, at_b: float, offset: float, power: float = 1.0, rows: int = 10, columns: int = 8) -> ArrayMesh:
+	var vertices := PackedVector3Array()
+	var normals := PackedVector3Array()
+	var indices := PackedInt32Array()
+	for row in range(rows + 1):
+		var ring: Vector4 = _profile_at(rings, lerpf(at_a, at_b, float(row) / rows), 4)
+		for column in range(columns + 1):
+			var angle: float = lerpf(angle_a, angle_b, float(column) / columns)
+			var cs: float = signf(cos(angle)) * pow(absf(cos(angle)), power)
+			var sn: float = signf(sin(angle)) * pow(absf(sin(angle)), power)
+			var normal := Vector3(cs / maxf(0.002, ring.y), 0, sn / maxf(0.002, ring.z)).normalized()
+			vertices.append(Vector3(cs * ring.y, ring.x, ring.w + sn * ring.z) + normal * offset)
+			normals.append(normal)
+	for row in range(rows):
+		for column in range(columns):
+			var a: int = row * (columns + 1) + column
+			var b: int = a + columns + 1
+			indices.append_array(PackedInt32Array([a, a + 1, b, a + 1, b + 1, b]))
+	var arrays: Array = []
+	arrays.resize(Mesh.ARRAY_MAX)
+	arrays[Mesh.ARRAY_VERTEX] = vertices
+	arrays[Mesh.ARRAY_NORMAL] = normals
+	arrays[Mesh.ARRAY_INDEX] = indices
+	var patch := ArrayMesh.new()
+	patch.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	return patch
+
+
+## Vorderste Oberfläche eines liegenden Lofts entlang z (Schnauze) für einen Punkt (x, y).
+func _snout_front_z(rings: Array[Vector4], x: float, y: float, steps: int = 4) -> float:
+	var samples: Array[Vector4] = []
+	for index in range(rings.size() - 1):
+		for j in range(steps):
+			samples.append(_catmull(rings[maxi(0, index - 1)], rings[index], rings[index + 1], rings[mini(rings.size() - 1, index + 2)], float(j) / steps))
+	samples.append(rings[-1])
+	var previous: float = -1.0
+	for index in range(samples.size()):
+		var ring: Vector4 = samples[index]
+		var dx: float = x / maxf(0.002, ring.y)
+		var dy: float = (y - ring.w) / maxf(0.002, ring.z)
+		var inside: float = 1.0 - (dx * dx + dy * dy)
+		if inside >= 0.0:
+			if index == 0:
+				return ring.x
+			return lerpf(samples[index - 1].x, ring.x, previous / (previous - inside))
+		previous = inside
+	return samples[-1].x
 
 
