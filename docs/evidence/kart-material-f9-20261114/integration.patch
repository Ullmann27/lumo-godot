+		var core: MeshInstance3D = kart._ring(body,
+			Vector3(side * 0.34, 0.466, 1.174), 0.046, 0.067, accent, 0.35, 0.60)
+		core.rotation.x = PI * 0.5
+		core.material_override = kart._mat(accent, 0.35, 0.26, 0.75)
+		_detail(core, "ExhaustEnergyRing", true)
